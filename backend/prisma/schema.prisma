generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemStatus {
  LOST
  FOUND
  MATCHED
  RETURNED
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lostItems LostItem[]
}

model LostItem {

  id String @id @default(cuid())

  title String

  description String

  category String

  locationLost String

  dateLost DateTime

  imageUrl String

  imagePublicId String

  status ItemStatus @default(LOST)

  createdBy String

  admin Admin @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model FoundItem {

  id String @id @default(cuid())

  reporterName String

  phone String

  email String?

  title String

  description String

  category String

  locationFound String

  dateFound DateTime

  imageUrl String

  imagePublicId String

  status ItemStatus @default(FOUND)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}