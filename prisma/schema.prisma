generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

}

model LostItem {
  id            String     @id @default(cuid())

  reporterName  String
  phone         String
  email         String

  title         String
  description   String
  category      String
  locationLost  String
  dateLost      DateTime

  imageUrl      String?
  imagePublicId String?

  status        LostStatus @default(ACTIVE)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Short public code (e.g. "LF-2026-00124") a reporter can use to check status
  // without logging in, instead of handing out the internal cuid.
  trackingId    String     @unique

  matches       Match[]

  @@index([status])
  @@index([category])
  @@index([dateLost])
}

model FoundItem {
  id            String      @id @default(cuid())

  reporterName  String
  phone         String
  email         String?

  title         String
  description   String
  category      String
  locationFound String
  dateFound     DateTime

  imageUrl      String
  imagePublicId String

  status        FoundStatus @default(PENDING)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // See LostItem.trackingId — same shared "LF-YYYY-NNNNN" numbering.
  trackingId    String      @unique

  matches       Match[]

  @@index([status])
  @@index([category])
  @@index([dateFound])
}

// One row per (lostItem, foundItem) pair that scored 70+ on the matching engine.
// Storing it (instead of recomputing on every page load) lets us know whether we've
// already emailed the reporter about this specific pair, and gives the admin panel
// a "potential matches" list to review without rescanning both tables every time.
model Match {
  id String @id @default(cuid())

  lostItemId String
  lostItem   LostItem @relation(fields: [lostItemId], references: [id], onDelete: Cascade)

  foundItemId String
  foundItem   FoundItem @relation(fields: [foundItemId], references: [id], onDelete: Cascade)

  score      Int
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lostItemId, foundItemId])
  @@index([score])
}

// One row per calendar year, holding the last tracking number handed out that year.
// LostItem and FoundItem share this single counter so "LF-2026-00124" is unique
// across BOTH tables, not just within one of them.
model TrackingCounter {
  year  Int @id
  value Int @default(0)
}

enum LostStatus {
  ACTIVE
  RETURNED
}

enum FoundStatus {
  PENDING
  AVAILABLE
  RETURNED
}
