generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

}

model LostItem {
  id            String     @id @default(cuid())

  reporterName  String
  phone         String
  email         String?

  title         String
  description   String
  category      String
  locationLost  String
  dateLost      DateTime

  imageUrl      String?
  imagePublicId String?

  status        LostStatus @default(ACTIVE)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([category])
  @@index([dateLost])
}

model FoundItem {
  id            String      @id @default(cuid())

  reporterName  String
  phone         String
  email         String?

  title         String
  description   String
  category      String
  locationFound String
  dateFound     DateTime

  imageUrl      String
  imagePublicId String

  status        FoundStatus @default(PENDING)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  claims        Claim[]

  @@index([status])
  @@index([category])
  @@index([dateFound])
}

model Claim {
  id String @id @default(cuid())

  foundItemId String
  foundItem FoundItem @relation(fields: [foundItemId], references: [id], onDelete: Cascade)

  claimantName String
  phone String
  email String?

  proof String

  status ClaimStatus @default(PENDING)
claimedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([foundItemId])
}

enum LostStatus {
  ACTIVE
  RETURNED
}

enum FoundStatus {
  PENDING
  AVAILABLE
  RETURNED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}
